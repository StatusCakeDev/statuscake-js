{
  "name": "@statuscake/statuscake-js",
  "version": "1.2.0",
  "description": "StatusCake API client",
  "keywords": [
    "sdk",
    "statuscake",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StatusCakeDev/statuscake-js.git"
  },
  "license": "MIT",
  "author": {
    "name": "StatusCake",
    "email": "support@statuscake.com",
    "url": "https://www.statuscake.com"
  },
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/mark-module-types.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint .",
    "check:package": "publint && attw --pack . --profile node16",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.14.0",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  }
}
